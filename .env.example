# CATECH Learn — Multi-Tenant E-Learning SaaS Platform
# Environment Configuration Template

# -----------------------------------------------------------------------------
# Supabase & Database Configuration
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_your_service_role_key_here"
SUPABASE_PROJECT_ID="your-project-id"

# Public Vite variables (exposed to browser bundle)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# -----------------------------------------------------------------------------
# CATECH Platform & Domain Configuration
# -----------------------------------------------------------------------------
PLATFORM_BASE_DOMAIN="catech.co.ke"
PLATFORM_APP_URL="https://learn.catech.co.ke"

# -----------------------------------------------------------------------------
# M-Pesa Daraja API Integration (Kenya & East Africa)
# -----------------------------------------------------------------------------
MPESA_ENVIRONMENT="sandbox" # "sandbox" or "live"
MPESA_CONSUMER_KEY="your_daraja_consumer_key"
MPESA_CONSUMER_SECRET="your_daraja_consumer_secret"
MPESA_BUSINESS_SHORTCODE="174379"
MPESA_PASSKEY="your_daraja_passkey"
MPESA_CALLBACK_URL="https://learn.catech.co.ke/api/payments/mpesa/callback"

# -----------------------------------------------------------------------------
# Storage & CDN (S3-Compatible / Supabase Storage)
# -----------------------------------------------------------------------------
STORAGE_BUCKET_COURSE_MEDIA="course-media"
STORAGE_BUCKET_SUBMISSIONS="student-submissions"
STORAGE_BUCKET_CERTIFICATES="issued-certificates"

# -----------------------------------------------------------------------------
# Communications (Email / SMS)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.provider.com"
SMTP_PORT=587
SMTP_USER="notifications@catech.co.ke"
SMTP_PASS="your_smtp_password"
AFRICASTALKING_USERNAME="catech"
AFRICASTALKING_API_KEY="your_at_key_here"
